<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="auth_session.xml" />
        <exclude
            domain="database"
            path="neurafit.db" />
        <exclude
            domain="database"
            path="neurafit.db-shm" />
        <exclude
            domain="database"
            path="neurafit.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="auth_session.xml" />
        <exclude
            domain="database"
            path="neurafit.db" />
        <exclude
            domain="database"
            path="neurafit.db-shm" />
        <exclude
            domain="database"
            path="neurafit.db-wal" />
    </device-transfer>
</data-extraction-rules>
