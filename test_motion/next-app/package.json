{
  "name": "next-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "db:migrate": "node server/db/migrate.mjs",
    "dev:all": "concurrently \"npm:dev:web-only\" \"npm:dev:api\" \"npm:dev:signal\"",
    "dev:api": "node server/api-server.mjs",
    "dev:signal": "node server/signaling-server.mjs",
    "dev:web": "concurrently \"npm:dev:web-only\" \"npm:dev:api\"",
    "dev:web-only": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@studio-freight/lenis": "^1.0.23",
    "@tailwindcss/vite": "^4.2.1",
    "@types/jquery": "^4.0.0",
    "@types/lodash": "^4.17.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "jquery": "^3.5.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.14.0",
    "mysql2": "^3.22.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-wrap-balancer": "^1.1.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1"
  }
}
