# Local database settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=neurafit_user
DB_PASSWORD=replace-with-your-local-password
DB_NAME=neurafit_db
DB_CONNECT_TIMEOUT=10000
DB_CONNECTION_LIMIT=10

# Local services
API_PORT=8788
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8787
VITE_API_BASE_URL=/api
VITE_SIGNALING_URL=ws://127.0.0.1:8787/motion-signaling
VITE_SIGNALING_PORT=8787

# Optional third-party services. Keep real values only in .env.local.
QWEATHER_API_KEY=
QWEATHER_API_HOST=
DEEPSEEK_API_KEY=
NETEASE_OPEN_API_APP_ID=
NETEASE_OPEN_API_APP_SECRET=
NETEASE_OPEN_API_PUBLIC_KEY=
NETEASE_OPEN_API_PRIVATE_KEY=
NETEASE_OPEN_API_ACCESS_TOKEN=
NETEASE_OPEN_API_FEATURED_TRACK_IDS=

# WebRTC development defaults. Add TURN servers in your local environment when needed.
VITE_RTC_FORCE_RELAY=false
VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
